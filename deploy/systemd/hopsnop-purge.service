[Unit]
Description=Hopsnop retention purge, dry run (deploy/README.md, Retention purge)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/hopsnop/deploy
# No --execute: it prints what it would remove and removes nothing.
ExecStart=/usr/bin/flock /run/lock/hopsnop.lock /usr/bin/docker compose run --rm --no-deps purge
