# Copy to deploy/.env on the server, fill in, then: chmod 600 .env
# .env is never committed (.gitignore) and holds every secret of the site.
# Keep a copy in a password manager: without TWO_FACTOR_KEY a restored backup
# loses every two-factor secret. Generate each secret with the command shown.

# --- Where the site is (Caddy, and the URLs the API and the pages are built with)
SITE_DOMAIN=hopsnop.com
API_DOMAIN=api.hopsnop.com

# --- PostgreSQL. Only read when the database is first created; changing it
# later needs ALTER USER as well (deploy/README.md). URL-safe, as it goes into
# DATABASE_URL:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- The API. ENVIRONMENT, DATABASE_URL, FRONTEND_URL and IMAGE_STORAGE_PATH
# are set by compose.yml. The purge gets exactly these settings as well.

# Key of the rate-limit hashes, at least 32 characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RATE_LIMIT_SECRET=

# Encrypts two-factor secrets: 32 random bytes in base64url. Never change it
# once users have turned two-factor login on:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TWO_FACTOR_KEY=

# From the Resend dashboard: a key with sending access for hopsnop.com only.
# Keep open and click tracking off for the domain (backend/README.md, Email).
RESEND_API_KEY=
EMAIL_FROM="Hopsnop <no-reply@hopsnop.com>"

# --- Optional, shown with their defaults (backend/README.md, Configuration,
# Rate limiting and Retention).
# WEB_CONCURRENCY=2
# EMAILS_PER_DAY=80
# EMAILS_PER_ADDRESS_AND_IP_PER_DAY=5
# EXPIRED_STORY_RETENTION_HOURS=24
# ENDED_SESSION_RETENTION_DAYS=30
# SPENT_TOKEN_RETENTION_DAYS=7
# RATE_LIMIT_RETENTION_HOURS=1
# ORPHANED_IMAGE_RETENTION_HOURS=1
# PURGE_BATCH_SIZE=1000
# Only once verification emails are known to arrive (backend/README.md, Retention).
# PURGE_UNVERIFIED_ACCOUNTS=false
# UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
