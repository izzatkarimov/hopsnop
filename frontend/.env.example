# Copy this file to .env.local and adjust the values for your machine.
# .env.local is ignored by git; this example file is the only env file tracked.

# Base URL of the Hopsnop API (the FastAPI backend), without a trailing slash.
#
# NEXT_PUBLIC_ variables are built into the JavaScript sent to the browser, so
# they are public. Never put a secret in one.
#
# Use the same host name that you open the frontend with. The session cookie
# is only sent between addresses the browser considers the same site:
# localhost:3000 and localhost:8000 are, localhost:3000 and 127.0.0.1:8000
# are not.
NEXT_PUBLIC_API_URL=http://localhost:8000
